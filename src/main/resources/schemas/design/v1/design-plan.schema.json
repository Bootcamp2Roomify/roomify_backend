{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomify.example/schemas/design/v1/design-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planVersion",
    "summary",
    "designStyle",
    "actions",
    "layoutNotes",
    "budgetAllocation",
    "estimatedTotalCost",
    "currency",
    "warnings",
    "itemsNeeded",
    "rentalFriendlyWarnings",
    "constraints"
  ],
  "properties": {
    "planVersion": {
      "const": "1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "designStyle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "\\S"
    },
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId",
          "objectClass",
          "decision",
          "type",
          "instruction",
          "rationale"
        ],
        "properties": {
          "objectId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "objectClass": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "decision": {
            "enum": [
              "KEEP",
              "REPLACE",
              "REMOVE",
              "UNSURE",
              null
            ]
          },
          "type": {
            "enum": [
              "KEEP",
              "KEEP_AND_REPOSITION",
              "REPLACE",
              "REMOVE",
              "UNSURE",
              "ADD"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ADD"
                }
              }
            },
            "then": {
              "properties": {
                "objectId": {
                  "type": "null"
                },
                "decision": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "objectId": {
                  "type": "string",
                  "format": "uuid"
                },
                "decision": {
                  "enum": [
                    "KEEP",
                    "REPLACE",
                    "REMOVE",
                    "UNSURE"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "layoutNotes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "budgetAllocation": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "item",
          "purpose",
          "estimatedCost"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "estimatedCost": {
            "type": "number",
            "minimum": 0,
            "maximum": 9999999999.99,
            "multipleOf": 0.01
          }
        }
      }
    },
    "estimatedTotalCost": {
      "type": "number",
      "minimum": 0,
      "maximum": 9999999999.99,
      "multipleOf": 0.01
    },
    "currency": {
      "enum": [
        "TWD",
        "USD"
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "itemsNeeded": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId",
          "name",
          "quantity"
        ],
        "properties": {
          "objectId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "rentalFriendlyWarnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    }
  }
}
