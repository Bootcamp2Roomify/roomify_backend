%% Roomify system architecture. Rendered by docs/submission/build.sh.
flowchart TB
  user(["Person with a room photo · browser, desktop or phone"])

  subgraph FE["Roomify frontend · Next.js 15 / React 19"]
    direction LR
    pages["Pages<br/>dashboard · new room · review ·<br/>preferences · redesign workspace"]
    bridge["Route handlers /api/*<br/>httpOnly session cookie → Bearer token"]
  end

  subgraph BE["Roomify API · Spring Boot 3.5 / Java 21"]
    direction LR
    auth["Auth and ownership<br/>BCrypt · HS256 JWT · 404 for foreign projects"]
    flow["Project workflow<br/>upload · analysis · decisions · preferences"]
    gen["Generation and guardrails<br/>plan · concept · suggestions · DIY<br/>budget, decision, rental and safety checks"]
  end

  cv["Roomify CV service · FastAPI<br/>YOLO11n (ONNX Runtime): bed · chair · sofa ·<br/>table · tv · plant"]
  llm["OpenAI gpt-4o-mini<br/>JSON plans, suggestions, DIY"]
  img["OpenAI gpt-image-2.5-sunburst<br/>edits the user's photo"]
  pg[("PostgreSQL 17<br/>projects, detections, decisions,<br/>designs, suggestions, guides")]
  store[("Photo storage · Postgres table<br/>(live) or AWS S3<br/>room photos, concepts")]

  user -- HTTPS --> pages
  pages --> bridge
  bridge -- "REST + Bearer" --> auth
  auth --> flow
  auth --> gen
  flow -- "photo" --> cv
  gen -- "chat completions" --> llm
  gen -- "image edits" --> img
  flow --> pg
  gen --> pg
  flow --> store
  gen --> store
