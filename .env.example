# Spring Boot application
PORT=8080

# PostgreSQL database
# Use DB_HOST=db inside Docker Compose, DB_HOST=localhost when running the backend on your machine
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roomify
DB_USERNAME=roomify
DB_PASSWORD=replace_with_your_local_password

# Authentication: HS256 signing secret, at least 32 bytes (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_at_least_32_random_bytes
# Access-token lifetime (ISO-8601 or Spring duration, e.g. 1h)
JWT_TTL=1h

# AI services. OPENAI_API_KEY is used for text plans and images unless AI_API_KEY is set.
OPENAI_API_KEY=

# Computer vision service (no trailing slash)
CV_SERVICE_URL=http://localhost:8000

# Storage: local or s3
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_LOCAL_BUCKET=local
ROOM_IMAGE_MAX_SIZE_BYTES=10485760

# AWS S3 cloud storage (required when STORAGE_TYPE=s3)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=your_bucket_name


# Maximum budget in the selected currency; no currency conversion.
PREFERENCES_MAX_BUDGET_AMOUNT=1000000

# Maximum generated-image upload size in bytes.
DESIGN_IMAGE_MAX_SIZE_BYTES=10485760

# Text-design provider. Set an available model and inject the real key locally.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
# Optional override of OPENAI_API_KEY for the text provider
AI_API_KEY=
# Visual prototype (OpenAI image edits)
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_QUALITY=low
AI_BASE_URL=https://api.openai.com/v1
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=60s
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_RETRIES=1
