# Spring Boot application
PORT=8080

# PostgreSQL database
# Use DB_HOST=db inside Docker Compose, DB_HOST=localhost when running the backend on your machine
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roomify
DB_USERNAME=roomify
DB_PASSWORD=replace_with_your_local_password

# Authentication
JWT_SECRET=your_jwt_secret

# AI services
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Computer vision service (no trailing slash)
CV_SERVICE_URL=http://localhost:8000

# Storage: local or s3
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_LOCAL_BUCKET=local
ROOM_IMAGE_MAX_SIZE_BYTES=10485760

# AWS S3 cloud storage (required when STORAGE_TYPE=s3)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=your_bucket_name
